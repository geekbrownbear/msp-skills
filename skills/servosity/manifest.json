{
  "manifest_version": "0.3",
  "name": "servosity-mcp",
  "display_name": "Servosity",
  "version": "0.5.0",
  "description": "The first MSP-fleet CLI for backup. Every Servosity API endpoint as a typed command, plus a local mirror that lets you ask questions the dashboard can't \u2014 across your whole book of clients.",
  "author": {
    "name": "Servosity Inc."
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/servosity-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/servosity-mcp",
      "args": [],
      "env": {
        "SERVOSITY_MSP_BASE_URL": "${user_config.servosity_msp_base_url}",
        "SERVOSITY_MSP_RESELLER_ID": "${user_config.servosity_msp_reseller_id}",
        "SERVOSITY_MSP_TOKEN": "${user_config.servosity_msp_token}"
      }
    }
  },
  "user_config": {
    "servosity_msp_base_url": {
      "type": "string",
      "title": "SERVOSITY_MSP_BASE_URL",
      "description": "SERVOSITY_MSP_BASE_URL for Servosity",
      "required": false,
      "default": "https://api.servosity.com/api/v1"
    },
    "servosity_msp_reseller_id": {
      "type": "string",
      "title": "SERVOSITY_MSP_RESELLER_ID",
      "description": "SERVOSITY_MSP_RESELLER_ID for Servosity",
      "required": true
    },
    "servosity_msp_token": {
      "type": "string",
      "title": "SERVOSITY_MSP_TOKEN",
      "description": "Sets SERVOSITY_MSP_TOKEN for the Servosity MCP server.",
      "sensitive": true,
      "required": true
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  },
  "printing_press_version": "4.30.3",
  "press_provenance": {
    "printing_press_version": "4.30.3",
    "generated_at": "2026-08-17T11:55:02.26622Z",
