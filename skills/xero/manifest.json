      "default": "https://api.xero.com/api.xro/2.0"
    },
    "xero_base_url": {
      "type": "string",
      "title": "XERO_BASE_URL",
      "description": "Base URL of your Xero instance",
      "required": false,
      "default": "https://api.xero.com/api.xro/2.0"
    },
    "xero_client_id": {
      "type": "string",
      "title": "XERO_CLIENT_ID",
      "description": "OAuth2 client ID from your Xero API application",
