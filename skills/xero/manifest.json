    "xero_client_secret": {
      "type": "string",
      "title": "XERO_CLIENT_SECRET",
      "description": "OAuth2 client secret from your Xero API application",
      "sensitive": true,
      "required": true
    },
    "xero_oauth2": {
      "type": "string",
      "title": "XERO_OAUTH2",
      "description": "Optional. Sets XERO_OAUTH2 for the Xero MCP server.",
      "sensitive": true
