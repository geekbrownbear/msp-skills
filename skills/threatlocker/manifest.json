{
  "manifest_version": "0.3",
  "name": "threatlocker-pp-mcp",
  "display_name": "ThreatLocker",
  "version": "0.3.1",
  "description": "Every ThreatLocker Portal API feature, plus the write operations the read-only tools lack and a cross-tenant offline store no other ThreatLocker tool has.",
  "author": {
    "name": "Servosity Inc."
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/threatlocker-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/threatlocker-pp-mcp",
      "args": [],
      "env": {
        "PRINTING_PRESS_CLIENT_PROFILE": "${user_config.printing_press_client_profile}",
        "THREATLOCKER_API_KEY": "${user_config.threatlocker_api_key}",
        "THREATLOCKER_BASE_URL": "${user_config.threatlocker_base_url}",
        "THREATLOCKER_ORG_ID": "${user_config.threatlocker_org_id}"
      }
    }
  },
  "user_config": {
    "printing_press_client_profile": {
      "type": "string",
      "title": "Client profile",
      "description": "Binds the MCP server to an existing tenant-gated Printing Press client profile.",
      "required": true
    },
    "threatlocker_api_key": {
      "type": "string",
      "title": "THREATLOCKER_API_KEY",
      "description": "API key issued by ThreatLocker",
      "sensitive": true,
      "required": true
    },
    "threatlocker_base_url": {
      "type": "string",
      "title": "THREATLOCKER_BASE_URL",
      "description": "Base URL of your ThreatLocker instance",
      "required": false,
      "default": "https://portalapi.g.threatlocker.com/portalapi"
    },
    "threatlocker_org_id": {
      "type": "string",
      "title": "THREATLOCKER_ORG_ID",
      "description": "Organization ID in ThreatLocker",
      "required": true
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  },
  "printing_press_version": "4.30.2",
  "press_provenance": {
    "printing_press_version": "4.30.2",
    "generated_at": "2026-08-14T12:10:59.797419Z",
    "spec_checksum": "sha256:19913f157eae9479574851f0882e8dce587353811c9e013ba7584573ab433087",
    "spec_format": "internal"
  }
}
