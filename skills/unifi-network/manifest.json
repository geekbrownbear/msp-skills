{
  "manifest_version": "0.3",
  "name": "unifi-network-pp-mcp",
  "display_name": "UniFi",
  "version": "0.1.1",
  "description": "Every UniFi Network API operation, plus drift detection, topology, and rule prediction no other UniFi tool has.",
  "author": {
    "name": "Servosity Inc."
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/unifi-network-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/unifi-network-pp-mcp",
      "args": [],
      "env": {
        "UNIFI_API_KEY": "${user_config.unifi_api_key}",
        "UNIFI_BASE_PATH": "${user_config.unifi_base_path}",
        "UNIFI_BASE_URL": "${user_config.unifi_base_url}",
        "UNIFI_GATEWAY_HOST": "${user_config.unifi_gateway_host}",
        "UNIFI_INSECURE_SKIP_VERIFY": "${user_config.unifi_insecure_skip_verify}"
      }
    }
  },
  "user_config": {
    "unifi_api_key": {
      "type": "string",
      "title": "UniFi API key",
      "sensitive": true,
      "required": true,
      "description": "Local API key from the gateway UI: Settings > Control Plane > Integrations > Create API Key."
    },
    "unifi_base_path": {
      "type": "string",
      "title": "UNIFI_BASE_PATH",
      "description": "UNIFI_BASE_PATH for UniFi Network",
      "required": true
    },
    "unifi_base_url": {
      "type": "string",
      "title": "UNIFI_BASE_URL",
      "description": "Base URL of your UniFi Network instance",
      "required": true
    },
    "unifi_gateway_host": {
      "type": "string",
      "title": "Gateway host",
      "required": true,
      "description": "Hostname or IP of the UniFi OS gateway on your network, e.g. 10.0.0.1 (the CLI adds the /proxy/network prefix)."
    },
    "unifi_insecure_skip_verify": {
      "type": "string",
      "title": "UNIFI_INSECURE_SKIP_VERIFY",
      "description": "UNIFI_INSECURE_SKIP_VERIFY for UniFi Network",
      "required": true
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  },
  "printing_press_version": "4.30.1",
  "press_provenance": {
