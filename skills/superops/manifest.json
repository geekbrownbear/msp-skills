{
  "manifest_version": "0.3",
  "name": "superops-mcp",
  "display_name": "SuperOps",
  "version": "0.1.4",
  "description": "Every SuperOps PSA+RMM entity in your terminal, plus a local SQLite mirror that answers cross-entity questions the web UI can't.",
  "author": {
    "name": "Servosity Inc."
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/superops-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/superops-mcp",
      "args": [],
      "env": {
        "SUPEROPS_API_TOKEN": "${user_config.superops_api_token}",
        "SUPEROPS_BASE_URL": "${user_config.superops_base_url}",
        "SUPEROPS_REGION": "${user_config.superops_region}",
        "SUPEROPS_SUBDOMAIN": "${user_config.superops_subdomain}"
      }
    }
  },
  "user_config": {
    "superops_api_token": {
      "type": "string",
      "title": "SUPEROPS_API_TOKEN",
      "description": "Sets SUPEROPS_API_TOKEN for the SuperOps MCP server.",
      "sensitive": true,
      "required": true
    },
    "superops_base_url": {
      "type": "string",
      "title": "SUPEROPS_BASE_URL",
      "description": "Base URL of your SuperOps instance",
      "required": false,
      "default": "https://api.superops.ai"
    },
    "superops_region": {
      "type": "string",
      "title": "SUPEROPS_REGION",
      "description": "SuperOps region your credentials were issued for",
      "required": true
    },
    "superops_subdomain": {
      "type": "string",
      "title": "SUPEROPS_SUBDOMAIN",
      "description": "Your SuperOps subdomain",
      "required": true
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  },
  "printing_press_version": "4.24.0",
  "press_provenance": {
    "printing_press_version": "4.24.0",
    "generated_at": "2026-06-13T04:37:08.461331Z",
    "spec_checksum": "sha256:75c960f532ac96efb29a77b04304be15626dfca8c78be0092351be6ed34748fb",
    "spec_format": "internal"
  }
}
