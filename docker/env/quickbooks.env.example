# [required]
# QuickBooks Online environment (e.g. sandbox or production)
QUICKBOOKS_ENVIRONMENT=

# [required]
# Realm (company) ID in QuickBooks Online
QUICKBOOKS_REALM_ID=

# [required, secret]
