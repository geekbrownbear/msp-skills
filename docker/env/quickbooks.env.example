# GENERATED by tools/maintainer/build_compose.py - DO NOT EDIT.
# Credentials for the quickbooks connector.
#
# Copy to docker/env/quickbooks.env and fill in. That file is gitignored.
# Values here are visible to anyone who can run `docker inspect`; see
# docker/README.md for the graduation path to a secret store.

# [optional, secret]
# Static access token, as an alternative to the refresh trio for a quick test.
# Intuit access tokens live one hour and nothing refreshes one supplied this
# way, so prefer the refresh credentials for anything long-running.
# QUICKBOOKS_ACCESS_TOKEN=

# [optional]
# Derived from QUICKBOOKS_REALM_ID automatically; set only for sandbox
# (QUICKBOOKS_ENVIRONMENT=sandbox does that too) or a nonstandard host.
# QUICKBOOKS_BASE_URL=

# [required]
# OAuth2 client ID from your Intuit developer app (Keys & Credentials,
# production keys). With the client secret and a refresh token, the connector
# mints and refreshes its own access tokens, persisting rotations so a restart
# survives Intuit's refresh-token rotation.
QUICKBOOKS_CLIENT_ID=

# [required, secret]
# OAuth2 client secret paired with QUICKBOOKS_CLIENT_ID.
QUICKBOOKS_CLIENT_SECRET=

# [required]
# QuickBooks Online environment (e.g. sandbox or production)
QUICKBOOKS_ENVIRONMENT=

# [required]
# Your QuickBooks Online company ID. Shown beside the refresh token in the
# OAuth Playground, and in any QBO URL as companyid=<realm>.
QUICKBOOKS_REALM_ID=

# [required, secret]
# OAuth2 refresh token seed. Easiest source is Intuit's OAuth 2.0 Playground:
# authorize your app against your company with the
# com.intuit.quickbooks.accounting scope and copy the refresh token it prints.
# Intuit rotates this value; the connector persists rotations automatically.
QUICKBOOKS_REFRESH_TOKEN=

# [optional]
# Intuit's production token endpoint by default; override only for testing.
# QUICKBOOKS_TOKEN_URL=
