# ACTION1_CLIENT_ID=

# [optional, secret]
# Client Secret paired with ACTION1_CLIENT_ID, from the Action1 console's API
# Credentials page.
# ACTION1_CLIENT_SECRET=

# [required]
# ACTION1_OAUTH2 for Action1
ACTION1_OAUTH2=

# [required]
# Organization ID in Action1
ACTION1_ORG_ID=
