# GENERATED by tools/maintainer/build_compose.py - DO NOT EDIT.
# Credentials for the cipp connector.
#
# Copy to docker/env/cipp.env and fill in. That file is gitignored.
# Values here are visible to anyone who can run `docker inspect`; see
# docker/README.md for the graduation path to a secret store.

# [required, secret]
# Azure AD bearer JWT for your self-hosted CIPP instance. Obtained via OAuth2
# client-credentials against login.microsoftonline.com; 'auth login' performs
# the exchange and caches it. CIPP_API_KEY accepts a static bearer token.
CIPP_API_KEY=

# [optional]
# Azure AD authority host. Defaults to https://login.microsoftonline.com;
# override only for a sovereign cloud.
# CIPP_AUTHORITY=

# [required]
# Base URL of your CIPP instance
CIPP_BASE_URL=

# [required, secret]
# Azure AD application (client) ID of the CIPP API client. Create it in CIPP:
# Integrations > CIPP-API > Create New Client (a read-only Custom Role is
# safest to start). With this, CIPP_CLIENT_SECRET and CIPP_TENANT_ID set, the
# connector mints and refreshes its own access token, which is what lets it
# run unattended. Supply CIPP_API_KEY instead if you would rather hand it a
# static bearer token.
CIPP_CLIENT_ID=

# [required, secret]
# Client secret paired with CIPP_CLIENT_ID.
CIPP_CLIENT_SECRET=

# [optional]
# OAuth2 scope for the client-credentials exchange. Defaults to
# api://<client-id>/.default, which is correct for most CIPP deployments; set
# it only when your app registration exposes a different scope.
# CIPP_OAUTH_SCOPE=

# [required]
# Azure AD tenant (directory) ID that hosts the CIPP API app registration.
CIPP_TENANT_ID=
