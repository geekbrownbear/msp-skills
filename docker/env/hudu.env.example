# Credentials for the hudu connector.
#
# Copy to docker/env/hudu.env and fill in. That file is gitignored.
# Values here are visible to anyone who can run `docker inspect`; see
# docker/README.md for the graduation path to a secret store.

# [required, secret]
# Raw Hudu API key sent as the `x-api-key` header (no Bearer prefix). Create
# it in the Hudu portal: Admin -> API Keys. Keys may be global or
# company-scoped; company-scoped keys cannot call the global `assets list`
# endpoint (use `assets list-by-company`).
HUDU_API_KEY=

# [required]
# Your Hudu instance's API base URL, including the /api/v1 path, e.g.
# https://your-subdomain.huducloud.com/api/v1 (self-hosted, *.huducloud.com,
# or a custom domain).
HUDU_BASE_URL=
