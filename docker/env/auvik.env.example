# Credentials for the auvik connector.
#
# Copy to docker/env/auvik.env and fill in. That file is gitignored.
# Values here are visible to anyone who can run `docker inspect`; see
# docker/README.md for the graduation path to a secret store.

# [required, secret]
# Auvik > Admin > Integrations > Auvik API. This is the password half of the
# Basic credential.
AUVIK_API_KEY=

# [required]
# Your Auvik region's host, with no path suffix - for example
# https://auvikapi.us1.my.auvik.com. The wrong region returns a 401 that looks
# like a bad key.
AUVIK_BASE_URL=

# [required]
# The email address of the Auvik user whose API key you are using. Auvik
# authenticates with HTTP Basic; this is the username half.
AUVIK_USERNAME=
