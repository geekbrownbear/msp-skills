# GENERATED by tools/maintainer/build_compose.py - DO NOT EDIT.
# Credentials for the immybot connector.
#
# Copy to docker/env/immybot.env and fill in. That file is gitignored.
# Values here are visible to anyone who can run `docker inspect`; see
# docker/README.md for the graduation path to a secret store.

# [optional]
# Base URL of your ImmyBot instance
# IMMYBOT_BASE_URL=

# [optional, secret]
# Application (client) ID of the Entra app registration. Add that app's
# Enterprise Application object ID as an admin person in ImmyBot (Show More >
# People > New > AD External ID).
# IMMYBOT_CLIENT_ID=

# [optional, secret]
# Client secret paired with IMMYBOT_CLIENT_ID, from the Entra app
# registration.
# IMMYBOT_CLIENT_SECRET=

# [optional]
# IMMYBOT_OAUTH_SCOPE for ImmyBot
# IMMYBOT_OAUTH_SCOPE=

# [optional]
# Your ImmyBot instance subdomain - the "acme" in acme.immy.bot. Required: it
# derives the OAuth scope, and without it the token request falls back to a
# scope naming your own app registration and Entra rejects it.
# IMMYBOT_SUBDOMAIN=

# [optional]
# Directory (tenant) ID of the Microsoft Entra tenant your ImmyBot instance
# trusts.
# IMMYBOT_TENANT_ID=

# [optional]
# OAuth2 token endpoint for ImmyBot
# IMMYBOT_TOKEN_URL=
