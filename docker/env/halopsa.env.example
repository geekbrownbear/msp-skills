# [optional]
# Base URL of your HaloPSA instance
# HALOPSA_BASE_URL=

# [required]
# OAuth2 client ID from your Halo API application
HALOPSA_CLIENT_ID=

# [required, secret]
# OAuth2 client secret from your Halo API application
HALOPSA_CLIENT_SECRET=

# [optional]
# Sets HALOPSA_DOMAIN for the endpoint template variable {domain}.
